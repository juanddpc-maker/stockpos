# ── StockPOS — Variables de Entorno ──────────────────────────────────────────
# Copia este archivo como  .env  y ajusta los valores.
# El archivo .env NUNCA debe subirse a git (ya está en .gitignore).

# ─── Base de Datos ────────────────────────────────────────────────────────────
# LOCAL/DEV: deja comentado → se usa SQLite automáticamente
# PRODUCCIÓN: descomenta y pon tu URL de PostgreSQL
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/stockpos

# Ejemplos por plataforma:
# Railway:   postgresql://postgres:xxxx@containers-us-west-xxx.railway.app:6475/railway
# Render:    postgresql://stockpos_user:xxxx@dpg-xxx.oregon-postgres.render.com/stockpos
# Heroku:    (se define automáticamente al agregar el add-on Heroku Postgres)
# Supabase:  postgresql://postgres:xxxx@db.xxxx.supabase.co:5432/postgres
# Docker:    postgresql://postgres:postgres@localhost:5432/stockpos

# ─── Agente IA (GROQ) ────────────────────────────────────────────────────────
# Obtén tu key gratis en https://console.groq.com
GROQ_API_KEY=

# ─── Streamlit (opcional) ────────────────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
